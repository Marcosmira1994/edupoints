{
  "_about": "Implementation mirror extracted from design/ui.css. DESIGN.md frontmatter is the normative portable specification; historical design studies are not production authority.",
  "color": {
    "bg": "#0c0d0f",
    "surface": "#151619",
    "surface-2": "#1e2024",
    "border": "#303238",
    "border-input": "#696d77",
    "text": "#f4f4f5",
    "text-muted": "#a9adb7",
    "accent": "#ff7a45",
    "on-accent": "#211007",
    "accent-2": "#99bb98",
    "lime": "#9bd3aa",
    "gold": "#e3b86b",
    "danger": "#ff9292",
    "success": "#9bd3aa"
  },
  "font": {
    "sans": "Inter, system-ui, sans-serif",
    "display": "Oxanium, system-ui, sans-serif"
  },
  "type": {
    "heading": {
      "line": 1.2,
      "size": "clamp(28px,3vw,38px)",
      "weight": 700
    },
    "input": {
      "weight": 400,
      "size": 16
    },
    "label": {
      "weight": 500,
      "size": 12
    },
    "leader-points": {
      "line": 1,
      "size": 32,
      "weight": 700
    },
    "leader-name": {
      "line": 1.4,
      "size": 17,
      "weight": 600
    },
    "body": {
      "line": 1.6,
      "size": 13,
      "weight": 400
    },
    "table-points": {
      "weight": 600,
      "size": 19
    }
  },
  "space": [
    8,
    10,
    12,
    16,
    18,
    20,
    24,
    28,
    32,
    36
  ],
  "radius": {
    "chip": 7,
    "control": 8,
    "card": 14,
    "table": 12,
    "modal": 16,
    "item": 10
  },
  "shadow": {
    "connection": "0 16px 30px #0006",
    "menu": "0 14px 32px #0005"
  },
  "motion": {
    "press": "120ms",
    "fill": "500ms",
    "entrance": "280ms",
    "stagger": "35ms",
    "staggerCap": "175ms",
    "menu": "180ms",
    "modal": "220ms",
    "easeOut": "cubic-bezier(.23,1,.32,1)",
    "easeDrawer": "cubic-bezier(.32,.72,0,1)",
    "tiltMax": "2deg",
    "lift": "3px",
    "reducedMotion": "No positional/tilt/clip entrance; retain immediate state and focus feedback"
  },
  "breakpoints": {
    "mobile": "600px",
    "hideHeaderMenu": "1200px",
    "noRail": "900px",
    "compactRail": "1199px"
  }
}
